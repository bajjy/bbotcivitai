# --- Telegram ---
# Create the bot via @BotFather, paste the token here:
BOT_TOKEN=

# --- Civitai ---
# https://civitai.com/user/account -> "API Keys"
CIVITAI_API_KEY=

# --- Photo host (so Civitai can fetch the user's upload) ---
# Public URL where the bot will serve uploaded photos. Civitai must be able
# to GET this URL. Examples:
#   http://203.0.113.42:8088    (Hetzner VPS public IP, port opened in firewall)
#   https://bot.example.com     (domain pointed at the VPS, behind nginx + LE)
PUBLIC_HOST_URL=http://YOUR_VPS_IP:8088

# Port the photo-host listens on (must match PUBLIC_HOST_URL above unless nginx proxies it)
PHOTO_HOST_PORT=8088

# --- Generation tuning ---
# 0.0 = return source unchanged, 1.0 = ignore source. Civitai default 0.7.
# Lower values (0.25-0.45) give "enhance/upscale" feel without changing content.
QWEN_STRENGTH=0.35

# Default prompt used when the user just sends a photo with no caption.
QWEN_DEFAULT_PROMPT=high quality, sharp focus, fine detail, photorealistic, enhanced, 4k

# How many seconds to keep a hosted photo around before deleting it
PHOTO_TTL_SECONDS=900

# Optional: restrict the bot to specific Telegram user IDs (comma-separated).
# Leave blank to allow anyone.
ALLOWED_USER_IDS=
