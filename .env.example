# --- Telegram ---
# Create the bot via @BotFather, paste the token here:
BOT_TOKEN=

# --- Civitai ---
# https://civitai.com/user/account -> "API Keys"
CIVITAI_API_KEY=

# --- Photo host (kept for /healthz only; image is sent to Civitai as base64) ---
PUBLIC_HOST_URL=http://YOUR_VPS_IP:8088
PHOTO_HOST_PORT=8088

# --- Generation tuning ---
# 0.0 = return source unchanged, 1.0 = ignore source.
# 0.25-0.45 for "enhance" feel, 0.6-0.8 for re-imagine.
QWEN_STRENGTH=0.35

# Default prompt used when there is no caption (DM only).
QWEN_DEFAULT_PROMPT=high quality, sharp focus, fine detail, photorealistic, enhanced, 4k

# How long temp photos stay around if the bot crashes mid-flow.
PHOTO_TTL_SECONDS=900

# --- Access control ---
# Comma-separated lists. If both empty, the bot is open to anyone.
# Get user ID by messaging @userinfobot. Get chat ID by sending /chatid in the
# chat (you'll need to add the bot to the group first).
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=
